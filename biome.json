{
  "$schema": "https://biomejs.dev/schemas/2.3.4/schema.json",
  "extends": ["@arthurfiorette/biomejs-config"],
  "files": {
    "includes": [
      "apps/**/*",
      "packages/**/*",
      "!**/node_modules",
      "!**/.next",
      "!**/.turbo",
      "!**/.agents",
      "!**/dist",
      "!**/bun.lock"
    ]
  },
  "linter": {
    "rules": {
      "performance": {
        "noImgElement": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noDocumentCookie": "off"
      },
      "a11y": {
        "noStaticElementInteractions": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useUniqueElementIds": "off"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {
            "attributes": ["class", "className"],
            "functions": ["clsx", "cn", "cva", "tw", "twMerge"]
          }
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  }
}
