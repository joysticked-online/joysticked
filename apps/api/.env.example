RESEND_API_KEY='your_resend_api_key'
EMAIL_DOMAIN='delivered@resend.dev'
RESEND_WAITLIST_AUDIENCE_ID="your_waitlist_audience_id"

DATABASE_URL='postgres://postgres:your_secure_password@joysticked-postgres:5432/joysticked'

POSTGRES_DB='joysticked'
POSTGRES_PASSWORD='your_secure_password'
POSTGRES_USER='postgres'

CLIENT_URL='http://localhost:3000'
REDIS_URL="redis://joysticked-redis:6379"

# ─── Auth (Issue #6) ──────────────────────────────────────────────────────────

# Session signing key — must be at least 32 characters. Generate with:
#   openssl rand -hex 32
SESSION_SECRET='change_me_at_least_32_characters_long'

# Base URL of this API — used to build OAuth callback URLs
AUTH_CALLBACK_URL='http://localhost:8080'

# Google OAuth — create at https://console.cloud.google.com
# Authorized redirect URI: http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID='your_google_client_id'
GOOGLE_CLIENT_SECRET='your_google_client_secret'

# Discord OAuth — create at https://discord.com/developers/applications
# Redirect URI: http://localhost:8080/auth/discord/callback
DISCORD_CLIENT_ID='your_discord_client_id'
DISCORD_CLIENT_SECRET='your_discord_client_secret'

# ─── IGDB / Twitch API ────────────────────────────────────────────────────────
TWITCH_CLIENT_ID='your_twitch_client_id'
TWITCH_CLIENT_SECRET='your_twitch_client_secret'

# ─── Steam API ───────────────────────────────────────────────────────────────
STEAM_API_KEY='your_steam_api_key'
